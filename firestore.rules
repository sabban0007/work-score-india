rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidMobile(m) {
      return m is string && m.matches('^[6-9][0-9]{9}$');
    }

    function isValidOptionalMobile(m) {
      return m == '' || isValidMobile(m);
    }

    // Only these exact fields are ever allowed — anything extra is rejected outright
    function hasOnlyAllowedFields(d) {
      return d.keys().hasOnly([
        'name', 'mobile', 'city', 'skill', 'experience',
        'prevEmployer', 'prevEmployerMobile', 'aadhaarPhotoUploaded',
        'ratings', 'verifiedEmployers', 'jobsCompleted', 'jobsIncomplete',
        'aadhaarVerified', 'mobileVerified',
        'onTime', 'emergencyReady', 'teamLeader', 'multiSkill', 'safe', 'photo'
      ]);
    }

    // Core shape every worker document must always have — checked on BOTH
    // create and update, so even a compromised admin login can't push
    // out-of-range or wrong-type data into the database.
    function isValidWorkerCore(d) {
      return hasOnlyAllowedFields(d)
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && isValidMobile(d.mobile)
        && d.skill is string && d.skill.size() >= 2 && d.skill.size() <= 40
        && d.experience is number && d.experience >= 0 && d.experience <= 60
        && (!('city' in d) || (d.city is string && d.city.size() <= 60))
        && (!('prevEmployer' in d) || (d.prevEmployer is string && d.prevEmployer.size() <= 60))
        && (!('prevEmployerMobile' in d) || isValidOptionalMobile(d.prevEmployerMobile))
        && (!('aadhaarPhotoUploaded' in d) || d.aadhaarPhotoUploaded is bool)
        && (!('photo' in d) || (d.photo is string && d.photo.size() <= 10))
        && d.ratings is list && d.ratings.size() <= 2000
        && d.jobsCompleted is int && d.jobsCompleted >= 0 && d.jobsCompleted <= 100000
        && d.jobsIncomplete is int && d.jobsIncomplete >= 0 && d.jobsIncomplete <= 100000
        && d.verifiedEmployers is int && d.verifiedEmployers >= 0 && d.verifiedEmployers <= 3
        && d.aadhaarVerified is bool
        && d.mobileVerified is bool
        && (!('onTime' in d) || d.onTime is bool)
        && (!('emergencyReady' in d) || d.emergencyReady is bool)
        && (!('teamLeader' in d) || d.teamLeader is bool)
        && (!('multiSkill' in d) || d.multiSkill is bool)
        && (!('safe' in d) || d.safe is bool);
    }

    // Only YOUR specific admin account counts as admin — not just "anyone
    // logged in." This blocks a real attack: Firebase Email/Password sign-in
    // allows public self-registration by default, so without this check,
    // anyone could create their own account (bypassing this app entirely,
    // straight against the Firebase SDK) and pass as "admin."
    // IMPORTANT: confirm this matches your real admin email exactly.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'usysknate@gmail.com';
    }

    function isValidNewWorker(id, d) {
      return isValidWorkerCore(d)
        && d.mobile == id // doc ID must be the same mobile number stored in the doc
        && d.ratings.size() == 0
        && d.jobsCompleted == 0 && d.jobsIncomplete == 0
        && d.verifiedEmployers == 0
        && d.aadhaarVerified == false && d.mobileVerified == false;
    }

    match /workers/{mobile} {
      allow read: if true;
      // "resource == null" means no document exists yet at this mobile number —
      // this is what blocks duplicate registrations with the same number.
      allow create: if resource == null && isValidNewWorker(mobile, request.resource.data);
      // Admin-only edits. Every field is still fully type/range checked (not
      // just "which fields exist"), and the mobile/doc-ID link can never be
      // broken by an update — this holds even if the admin login is misused.
      allow update: if isAdmin()
        && isValidWorkerCore(request.resource.data)
        && request.resource.data.mobile == mobile;
      allow delete: if false;
    }
  }
}
