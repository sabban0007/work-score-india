rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidMobile(m) {
      return m is string && m.matches('^[6-9][0-9]{9}$');
    }

    function isValidOptionalMobile(m) {
      return m == '' || isValidMobile(m);
    }

    // Only these exact fields are ever allowed — anything extra is rejected outright
    function hasOnlyAllowedFields(d) {
      return d.keys().hasOnly([
        'name', 'mobile', 'city', 'skill', 'experience',
        'prevEmployer', 'prevEmployerMobile',
        'ratings', 'verifiedEmployers', 'jobsCompleted', 'jobsIncomplete',
        'aadhaarVerified', 'mobileVerified',
        'onTime', 'emergencyReady', 'teamLeader', 'multiSkill', 'safe', 'photo'
      ]);
    }

    function isValidNewWorker(id, d) {
      return hasOnlyAllowedFields(d)
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && isValidMobile(d.mobile)
        && d.mobile == id // doc ID must be the same mobile number stored in the doc
        && d.skill in ['Electrician', 'Plumber', 'Driver', 'Mistri', 'Welder', 'Painter', 'Helper']
        && d.experience is number && d.experience >= 0 && d.experience <= 60
        && (!('city' in d) || (d.city is string && d.city.size() <= 60))
        && (!('prevEmployer' in d) || (d.prevEmployer is string && d.prevEmployer.size() <= 60))
        && (!('prevEmployerMobile' in d) || isValidOptionalMobile(d.prevEmployerMobile))
        && d.ratings is list && d.ratings.size() == 0
        && d.jobsCompleted == 0 && d.jobsIncomplete == 0
        && d.verifiedEmployers == 0
        && d.aadhaarVerified == false && d.mobileVerified == false;
    }

    match /workers/{mobile} {
      allow read: if true;
      // "resource == null" means no document exists yet at this mobile number —
      // this is what blocks duplicate registrations with the same number.
      allow create: if resource == null && isValidNewWorker(mobile, request.resource.data);
      // Admin-only edits; the field set must stay within the same whitelist.
      allow update: if request.auth != null && hasOnlyAllowedFields(request.resource.data);
      allow delete: if false;
    }
  }
}
